# Sin NEXT_PUBLIC_SUPABASE_URL la app usa SQLite local en data/app.db.
# Si defines estas dos variables usa Supabase (tabla "products"):
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: clave de ScraperAPI para proxy con IP residencial en el scraping.
SCRAPERAPI_KEY=

# Opcional: ruta manual a Chrome/Edge (por defecto se auto-detecta; en el
# contenedor se usa /usr/bin/chromium).
CHROME_PATH=

# Railway inyecta PORT automaticamente.
PORT=3000