# TikTok Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=your_client_key_from_tiktok_developer
TIKTOK_CLIENT_SECRET=your_client_secret_keep_private
TIKTOK_REDIRECT_URI=https://your-domain.com/videos/api/tiktok/callback
# Para producción en Vercel, usa tu dominio definitivo, ej: https://creadorviral.com/api/tiktok/callback
# En desarrollo local: http://localhost:3000/videos/api/tiktok/callback

# Opcional: URL base pública para redirects (si no se infiere del request)
# NEXT_PUBLIC_BASE_URL=https://creadorviral.com
# NEXT_PUBLIC_BASE_PATH=/videos

# Para activar modo server (API routes) en local, NO pongas GITHUB_PAGES=true
# GITHUB_PAGES=true  # solo para GitHub Pages export estático
